# KNN Classification towards - Which continent has the most countries with the highest ranks of surival?

from sklearn.neighbors import KNeighborsClassifier

# Create a KNN classifier with 3 neighbors
knn = KNeighborsClassifier(n_neighbors=3)

# Train the classifier using the 'Overall Life' and 'Female Life' columns as features
knn.fit(life[['Overall Life', 'Female Life']], life['Continent'])

# Predict the continent for a new data point with 'Overall Life' of 75 and 'Female Life' of 80
predicted_continent = knn.predict([[75, 80]])

# Print the predicted continent
print(predicted_continent)


#Justify model with precision, recall and F1 score.
from sklearn.metrics import classification_report

# Predict the continent for each row
predicted_continents = knn.predict(life[['Overall Life', 'Female Life']])

# Print the classification report
print(classification_report(life['Continent'], predicted_continents))

accuracy = (predicted_continents == life['Continent']).mean()
print("Accuracy:", accuracy)

Overall the the F1 scores for Africa, Asia and Europe are the highest with a 72% accuracy.

# Use random forest tree to find best ranked continent & accuracy

